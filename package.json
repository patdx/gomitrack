{
  "name": "gomitrack",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "dev": "wireit",
    "start": "wireit",
    "typecheck": "wireit",
    "typegen": "wireit",
    "deploy": "wireit",
    "postinstall": "pnpm typegen"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.42.4",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@turf/bbox": "7.4.0",
    "@turf/helpers": "7.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "immer": "10.2.0",
    "isbot": "5.2.2",
    "lodash": "4.18.1",
    "lucide-react": "0.577.0",
    "luxon": "3.7.2",
    "maplibre-gl": "6.15.0",
    "mingo": "6.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "react-router": "7.12.0",
    "rrule": "2.8.1",
    "tailwind-merge": "3.7.0",
    "url-join": "5.1.1"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "0.2.3",
    "@playwright/mcp": "0.0.83",
    "@react-router/dev": "7.18.4",
    "@react-router/fs-routes": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/lodash": "4.17.27",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "3.8.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "20.3.0",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "5.1.4",
    "wireit": "0.14.13",
    "workerd": "1.20261023.1",
    "wrangler": "4.106.0"
  },
  "wireit": {
    "build": {
      "command": "react-router build",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "app/**",
        "vite.config.ts",
        "react-router.config.ts"
      ],
      "output": [
        "build/**"
      ]
    },
    "deploy": {
      "command": "wrangler deploy",
      "dependencies": [
        "build"
      ]
    },
    "dev": {
      "command": "react-router dev",
      "files": [
        "app/**",
        "vite.config.ts"
      ],
      "service": true
    },
    "start": {
      "command": "wrangler dev",
      "service": true
    },
    "typecheck": {
      "command": "tsc --build",
      "dependencies": [
        "typegen"
      ],
      "files": [
        "tsconfig.json",
        "app/**/*.ts",
        "app/**/*.tsx",
        "worker-configuration.d.ts",
        ".react-router/**"
      ],
      "output": [
        "tsconfig.tsbuildinfo"
      ]
    },
    "typegen": {
      "command": "node scripts/update-date.js && wrangler types && react-router typegen",
      "files": [
        "app/**",
        "react-router.config.ts",
        ".env",
        "wrangler.json"
      ],
      "output": [
        "worker-configuration.d.ts",
        ".react-router/**"
      ]
    }
  },
  "packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8",
  "pnpm": {
    "overrides": {
      "esbuild": "$esbuild",
      "@esbuild-plugins/node-globals-polyfill": "$@esbuild-plugins/node-globals-polyfill",
      "workerd": "$workerd"
    },
    "onlyBuiltDependencies": []
  }
}
